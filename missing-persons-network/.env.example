# --- Database ---
# Host is "db" — the Postgres service name in docker-compose.yml — NOT "localhost".
# Containers on the same Docker Compose network reach each other by service
# name; "localhost" inside a container means that container itself.
# Only change this to "localhost" if you're running the FastAPI app directly
# on your machine (outside Docker) — see "Understanding the connections" in
# README.md.
DATABASE_URL=postgresql+psycopg2://mpn_user:mpn_pass@db:5432/mpn_db

# Used by the pytest suite (app/tests/conftest.py) — a separate database so
# tests never touch dev data. Created automatically by
# scripts/init-test-db.sql on first `docker compose up`.
TEST_DATABASE_URL=postgresql+psycopg2://mpn_user:mpn_pass@db:5432/mpn_test_db

# --- Redis ---
# Same rule: "redis" is the service name, used when the API runs inside Docker.
REDIS_URL=redis://redis:6379/0

# --- JWT ---
SECRET_KEY=change-this-to-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- App ---
ENVIRONMENT=development
CORS_ORIGINS=["http://localhost:5173"]

# --- Rate limiting defaults ---
SIGHTING_REPORT_RATE_LIMIT=5/minute

# --- Frontend URL (used to build links in emails) ---
FRONTEND_URL=http://localhost:5173

# --- Email sending ---
# EMAIL_BACKEND=console (default): emails are just logged, not sent. Check
# `docker compose logs -f api` for verification/reset links during dev.
#
# To send REAL emails via Gmail (free, easiest option):
#   1. Turn on 2-Step Verification on the Google account you'll send from:
#      https://myaccount.google.com/security
#   2. Create an "App Password": https://myaccount.google.com/apppasswords
#      (choose "Mail" as the app). Google gives you a 16-character password --
#      that's SMTP_PASSWORD below, NOT your normal Gmail password.
#   3. Set the values below and change EMAIL_BACKEND to smtp.
# Any other provider (Outlook, a work email, SendGrid's SMTP relay, etc.)
# works the same way -- just change SMTP_HOST/PORT to that provider's values.
EMAIL_BACKEND=console
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-gmail-address@gmail.com
SMTP_PASSWORD=your-16-character-app-password
SMTP_FROM_EMAIL=your-gmail-address@gmail.com
SMTP_USE_TLS=true

# --- Photo uploads ---
UPLOAD_DIR=uploads
MAX_UPLOAD_BYTES=5242880

# --- Login lockout ---
LOGIN_FAILURE_THRESHOLD=5
LOGIN_FAILURE_WINDOW_SECONDS=900
LOGIN_LOCKOUT_SECONDS=900
