SECRET_KEY=your-secret-key-here-change-this
DATABASE_URL=mysql+pymysql://root:password@localhost/cold_weather_ev
# Postgres alternative (INFRA-1) -- swap the line above for this one:
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/cold_weather_ev
OPENWEATHERMAP_API_KEY=your_openweathermap_api_key_here
WEATHERAPI_KEY=your_weatherapi_key_here
GEMINI_API_KEY=your_gemini_api_key_here
# gemini-flash-latest is Google's own auto-updating alias for whichever
# Flash-tier (free) model they currently recommend -- deliberately not a
# dated model ID, since Google has been retiring those faster than their
# published shutdown dates in 2026. Override only if you want a specific
# pinned model instead.
GEMINI_MODEL=gemini-flash-latest
# Optional: fix the seeded admin/demo passwords instead of letting
# seed_data.py generate random ones (see README "Seed the Database").
# ADMIN_PASSWORD=
# DEMO_PASSWORD=
# SEED_DEMO_USER=true

# Phase 4 (SEC-1/SEC-2/RT-4): production hardening -- safe defaults for
# local dev, review before any public deployment. See README and
# docs/SECURITY_AND_ACCESS.md.
# CORS_ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
# RATELIMIT_STORAGE_URI=redis://localhost:6379
# ROUTING_PROVIDER=osrm
# OSRM_BASE_URL=http://localhost:5010
# ORS_API_KEY=
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_password
# MAIL_DEFAULT_SENDER=your_email@gmail.com   # defaults to MAIL_USERNAME if unset

# FEAT-2: Open Charge Map -- works keyless for light use; get a free key
# at https://openchargemap.org/site/develop/api for higher rate limits.
# OCM_API_KEY=

# FEAT-3: cold-snap alerts (needs MAIL_USERNAME/MAIL_PASSWORD above to
# actually send email -- without them, alerts are logged, not sent).
# ALERTS_ENABLED=true
# ALERT_CHECK_INTERVAL_MINUTES=60
# ALERT_COOLDOWN_HOURS=12

# RT-6: multi-waypoint route weather -- OFF by default (real API-call
# cost tradeoff, see README).
# WEATHER_MULTI_WAYPOINT_ENABLED=false
# WEATHER_WAYPOINT_INTERVAL_KM=150
# WEATHER_MAX_WAYPOINTS=6

# INFRA-3: weather response cache TTL in seconds (0 disables caching)
# WEATHER_CACHE_TTL_SECONDS=600

# Google / GitHub sign-in (Authlib) -- see README "Authentication" for
# how to register an OAuth app with each provider. Sign-in buttons only
# appear when the corresponding client ID is set.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

FLASK_ENV=development
FLASK_DEBUG=1
